# Forgot-password email job. Every 3 minutes the "cron" service sends the reset-confirmation email for
# password_reset_requests rows whose status is 0 (not yet sent) and sets them to 1.
# flock -n skips the run if the previous one is still going (a second guard on top of the atomic row claim).
# Same /etc/cron.d rules as low-stock.cron: user column required, trailing blank line required.
#
# minute hour day-of-month month day-of-week  user  command
*/3 * * * * root cd /var/www/html && /usr/bin/flock -n /tmp/password-reset.lock /usr/local/bin/php scripts/send-password-reset-emails.php >> /proc/1/fd/1 2>> /proc/1/fd/2

