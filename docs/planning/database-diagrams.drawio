<mxCell id="f_e6" style="html=1;endArrow=block;" edge="1" parent="1" source="f_submit" target="f_dec_approve"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f_e7" value="ya" style="html=1;endArrow=block;" edge="1" parent="1" source="f_dec_approve" target="f_approve"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f_e8" value="tidak" style="html=1;endArrow=block;" edge="1" parent="1" source="f_dec_approve" target="f_reject"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f_e9" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="f_reject" target="f_end"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f_e10" style="html=1;endArrow=block;" edge="1" parent="1" source="f_approve" target="f_lock"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f_e11" style="html=1;endArrow=block;" edge="1" parent="1" source="f_lock" target="f_dec_stock"><mxGeometry relative="1" as="geometry"/></mxCell>
