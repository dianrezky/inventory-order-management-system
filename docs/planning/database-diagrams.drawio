<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36" version="24.7.17" type="device">
  <diagram name="1. Alur Bisnis (Flow)" id="ioms-flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="f_start" value="Login&lt;br&gt;(Admin / Sales / WarehouseStaff)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="320" height="60" as="geometry"/></mxCell>

<mxCell id="f_md" value="Kelola Master Data [Admin]&lt;br&gt;writes: categories, products, warehouses, suppliers, customers, users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="320" height="70" as="geometry"/></mxCell>

<mxCell id="f_po" value="Buat Purchase Order [Admin]&lt;br&gt;writes: purchase_orders, purchase_order_items (Draft→Ordered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="250" width="320" height="70" as="geometry"/></mxCell>

<mxCell id="f_gr" value="Goods Receipt (full / partial) [WarehouseStaff]&lt;br&gt;TX: product_stocks +qty, stock_ledger(Receipt),&lt;br&gt;purchase_order_items.qty_received, po status recompute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="320" height="85" as="geometry"/></mxCell>

<mxCell id="f_so" value="Buat Sales Order [Sales]&lt;br&gt;writes: sales_orders, sales_order_items (Draft)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="485" width="320" height="65" as="geometry"/></mxCell>

<mxCell id="f_submit" value="Submit SO [Sales]&lt;br&gt;sales_orders.status = PendingApproval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="590" width="320" height="60" as="geometry"/></mxCell>

<mxCell id="f_dec_approve" value="Admin approve?&lt;br&gt;(BUKAN pembuat SO — BR-SOD-01/02)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="280" height="90" as="geometry"/></mxCell>

<mxCell id="f_reject" value="Reject [Admin]&lt;br&gt;sales_orders.status = Cancelled + cancellation_reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="705" width="280" height="60" as="geometry"/></mxCell>

<mxCell id="f_approve" value="Approved [Admin]&lt;br&gt;sales_orders.status = Approved, approved_by, approved_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="820" width="320" height="60" as="geometry"/></mxCell>

<mxCell id="f_lock" value="Goods Issue: mulai transaksi [WarehouseStaff]&lt;br&gt;SELECT ... FOR UPDATE product_stocks (ARCH-02 lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="920" width="320" height="65" as="geometry"/></mxCell>

<mxCell id="f_dec_stock" value="Stok cukup?&lt;br&gt;(ARCH-02 / BR-GI-02)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1015" width="280" height="90" as="geometry"/></mxCell>

<mxCell id="f_insufficient" value="400 Insufficient Stock&lt;br&gt;ROLLBACK — product_stocks, stock_ledger, sales_orders semua tidak berubah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="1030" width="280" height="65" as="geometry"/></mxCell>

<mxCell id="f_issueok" value="Goods Issue selesai [WarehouseStaff]&lt;br&gt;TX: product_stocks -qty, stock_ledger(Issue),&lt;br&gt;sales_orders.status=Fulfilled, issued_by/issued_at → COMMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1140" width="320" height="85" as="geometry"/></mxCell>

<mxCell id="f_view" value="Stock Ledger / Dashboard / CSV Report [Semua role, scoped]&lt;br&gt;reads: product_stocks, stock_ledger, sales_orders, purchase_orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1265" width="320" height="80" as="geometry"/></mxCell>

<mxCell id="f_end" value="Logout" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1385" width="320" height="50" as="geometry"/></mxCell>

