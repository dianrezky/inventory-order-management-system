# Production environment for IOMS behind Caddy (ioms.aetherxusory.my.id).
# Copy to `.env` on the VPS and fill in the secrets, then:
#   docker compose -f docker-compose.yaml -f docker-compose.prod.yml up -d --build
#
# Values marked REQUIRED have no default in docker-compose.yaml — Compose refuses
# to start the stack until they are set.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
DEFAULT_LOCALE=en

# Session cookie. In production the app marks the cookie Secure automatically when
# it sees Caddy's X-Forwarded-Proto: https, so no extra flag is needed here.
SESSION_NAME=iom_session
SESSION_LIFETIME=3600

# APP_PORT is unused in production (the prod overlay removes the published host
# port; Caddy reaches the container over the internal network). Kept for parity.
APP_PORT=8090

# ── Caddy wiring ───────────────────────────────────────────────────────────────
# The external Docker network created by the shared Caddy stack (deploy/). Default
# is deploy_internal; change only if that stack runs under a different compose
# project name. Verify with:  docker network ls | grep internal
CADDY_NETWORK=deploy_internal

# ── Database (MySQL 8) ─────────────────────────────────────────────────────────
DB_NAME=inventory_order_management
DB_USER=iom_app
DB_PASSWORD=                      # REQUIRED — app DB user password
DB_ROOT_PASSWORD=                 # REQUIRED — MySQL root password (db service)

# ── Cache ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
MEMCACHED_PORT=11211

# ── Object storage (shared MinIO) ──────────────────────────────────────────────
# Point the endpoint at the shared portfolio MinIO. MINIO_PUBLIC_URL is the URL the
# BROWSER loads product images from, so it must be publicly reachable over HTTPS —
# never localhost in production.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=                 # REQUIRED
MINIO_SECRET_KEY=                 # REQUIRED
MINIO_BUCKET=portfolio-uploads
MINIO_PUBLIC_URL=https://<your-public-minio-host>

# ── Security ───────────────────────────────────────────────────────────────────
# Obfuscates numeric ids in URLs. REQUIRED — set a long random string and keep it
# stable (changing it invalidates every id token already shared).
ID_OBFUSCATION_KEY=               # REQUIRED — e.g. output of: openssl rand -hex 32

# ── Forgot-password emails ─────────────────────────────────────────────────────
# Set these on the VPS (.env), then:  docker compose -f docker-compose.yaml -f docker-compose.prod.yml up -d --build
# The cron container sends the reset emails every 3 minutes through this SMTP account.
APP_URL=https://ioms.aetherxusory.my.id
MAIL_TRANSPORT=smtp
MAIL_HOST=                        # REQUIRED — SMTP server
MAIL_PORT=587
MAIL_ENCRYPTION=tls               # tls (STARTTLS, 587) | ssl (465)
MAIL_USERNAME=                    # REQUIRED if the server needs login
MAIL_PASSWORD=                    # REQUIRED if the server needs login (secret)
MAIL_FROM_ADDRESS=                # REQUIRED — must be allowed by your SMTP provider
MAIL_FROM_NAME="Inventory & Order Management"
