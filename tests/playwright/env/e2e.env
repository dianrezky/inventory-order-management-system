# IOMS E2E — throwaway, non-secret env for the ISOLATED stack only.
# Tracked in git on purpose: nothing here protects anything real — this
# database/bucket/session key exist only inside the disposable ioms-e2e
# Compose project and are destroyed/recreated on every `E2E_RESET=always` run.
# NEVER copy these values into the developer's real .env.

DB_NAME=ioms_e2e
DB_USER=ioms_e2e_app
DB_PASSWORD=ioms_e2e_pw
DB_ROOT_PASSWORD=ioms_e2e_root_pw

SESSION_NAME=ioms_e2e_session
SESSION_LIFETIME=28800
PHP_CLI_SERVER_WORKERS=8

SHORT_SESSION_NAME=ioms_e2e_short_session
SHORT_SESSION_LIFETIME=3

MINIO_ACCESS_KEY=ioms_e2e_minio
MINIO_SECRET_KEY=ioms_e2e_minio_secret
MINIO_BUCKET=ioms-e2e

ID_OBFUSCATION_KEY=ioms-e2e-fixed-obfuscation-key-do-not-use-in-prod

APP_HOST_PORT=18090
SHORT_SESSION_HOST_PORT=18091
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
