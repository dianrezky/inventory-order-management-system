# Environment template for IOMS (Inventory & Order Management System)
# Copy this file to `.env` and fill in your values before starting Docker:
#
#   cp .env.example .env
#   # edit .env â€” fill in all REQUIRED values
#   docker compose up -d --build
#
# Values marked REQUIRED have no default â€” Docker Compose will refuse to start
# until they are provided.

# â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
APP_ENV=local
APP_DEBUG=true
APP_PORT=8090
DEFAULT_LOCALE=en

# â”€â”€ Session â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SESSION_NAME=iom_session
SESSION_LIFETIME=3600

# â”€â”€ Database (MySQL 8) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DB_NAME=inventory_order_management
DB_USER=iom_app
DB_PASSWORD=secret          # REQUIRED â€” set a strong password
DB_ROOT_PASSWORD=root_secret # REQUIRED â€” MySQL root password

# â”€â”€ Cache â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_PORT=6379
MEMCACHED_PORT=11211

# â”€â”€ Object storage (MinIO) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# MinIO is external to this Compose project and may run on your VPS.
# VPS example: https://s3.example.com for endpoint and public URL.
# Use the S3 API endpoint, not the Console; do not append the bucket.
# See docs/ops/minio-vps-integration.md.
# MINIO_PUBLIC_URL is the URL the BROWSER uses to load images â€” must be
# reachable from your machine; use the VPS API domain for remote MinIO.
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin  # REQUIRED â€” MinIO access key
MINIO_SECRET_KEY=minioadmin  # REQUIRED â€” MinIO secret key
MINIO_BUCKET=portfolio-uploads
MINIO_PUBLIC_URL=http://localhost:9000

# â”€â”€ Security â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Obfuscates numeric IDs in URLs. Keep this stable â€” changing it invalidates
# all existing obfuscated ID tokens. Generate with:  openssl rand -hex 32
ID_OBFUSCATION_KEY=change-me-generate-with-openssl-rand-hex-32  # REQUIRED
